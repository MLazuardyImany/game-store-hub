# =====================================================================
# Game Store Hub — Environment Template
# ---------------------------------------------------------------------
# 1. Salin file ini:  Copy-Item .env.example .env.local
# 2. Isi setiap nilai dengan kredensial asli Anda.
# 3. `.env.local` TIDAK pernah di-commit (lihat .gitignore).
#
# Referensi variabel: WORKFLOW.md §3, ARCHITECTURE.md §2,
# PRD 11 (keamanan), PRD 06 (admin), PRD 09 (webhook).
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE — PostgreSQL (disarankan) atau MySQL
# ---------------------------------------------------------------------
# Format PostgreSQL : postgresql://USER:PASSWORD@HOST:5432/NAMA_DB
# Format MySQL      : mysql://USER:PASSWORD@HOST:3306/NAMA_DB
# Karakter khusus pada password (@ : / ?) harus di-encode URL
# (contoh: "@" menjadi "%40").
DATABASE_URL="postgresql://gamestore:password@localhost:5432/gamestore_db"

# ---------------------------------------------------------------------
# 2. CLOUDFLARE R2 — object storage screenshot (zero egress fee)
# ---------------------------------------------------------------------
# Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token
# (permission: Object Read & Write, scope: bucket di bawah ini).
CLOUDFLARE_ACCOUNT_ID="0000000000000000000000000000000a"
R2_ACCESS_KEY_ID="GANTI_DENGAN_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="GANTI_DENGAN_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="gamestore-media"

# Domain publik bucket untuk menyajikan gambar lewat CDN, tanpa garis
# miring di akhir. Contoh: https://pub-1a2b3c4d5e6f.r2.dev
# Dipakai next.config.ts untuk images.remotePatterns.
R2_PUBLIC_DOMAIN="https://pub-0000000000000000000000000000000a.r2.dev"

# ---------------------------------------------------------------------
# 3. ADMIN — autentikasi dashboard /admin
# ---------------------------------------------------------------------
# JWT secret: string acak, minimal 32 karakter.
# Bangkitkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET="GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER"

ADMIN_USERNAME="admin"

# Password TIDAK disimpan mentah: isi dengan hash bcrypt.
# Buat hash (setelah `npm i -D bcryptjs`):
#   node -e "console.log(require('bcryptjs').hashSync('PASSWORD_ANDA',12))"
#
# PENTING — sudah diuji pada Next.js 16: hash bcrypt diawali "$2b$12$...".
# Loader .env Next.js meng-expand pola $VAR, sehingga tanpa escape seluruh
# nilai menjadi string kosong. Tulis setiap tanda $ sebagai \$ , contoh:
#   ADMIN_PASSWORD_HASH="\$2b\$12\$HasilHashBcryptAnda..."
ADMIN_PASSWORD_HASH="GANTI_DENGAN_HASH_BCRYPT"

# ---------------------------------------------------------------------
# 4. NOTIFIKASI SELLER — dijalankan asynchronous saat CTA diklik
# ---------------------------------------------------------------------
# Discord: Server Settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/000000000000000000/GANTI_DENGAN_TOKEN_WEBHOOK"

# Telegram: buat bot lewat @BotFather, lalu ambil chat id (grup diawali "-")
TELEGRAM_BOT_TOKEN="000000000:GANTI_DENGAN_TOKEN_DARI_BOTFATHER"
TELEGRAM_CHAT_ID="-1000000000000"

# ---------------------------------------------------------------------
# 5. OPSIONAL — URL publik situs, dipakai untuk Open Graph absolut
# ---------------------------------------------------------------------
# Isi dengan domain produksi setelah deploy (tanpa garis miring di akhir).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
