# =====================================================================
# Environment template — Game Store Hub
# Salin ke `.env.local` lalu isi nilai aslinya. JANGAN commit `.env.local`.
# =====================================================================

# --- Database (PostgreSQL / MySQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/gamestore_db"

# --- Cloudflare R2 (S3-compatible, zero egress) ---
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="gamestore-bucket"
R2_PUBLIC_DOMAIN="https://pub-xxxx.r2.dev"

# --- Admin dashboard ---
ADMIN_JWT_SECRET="super-secret-jwt-key"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="bcrypt-hash-of-your-password"

# --- Notifikasi seller ---
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
TELEGRAM_BOT_TOKEN="123456789:ABC..."
TELEGRAM_CHAT_ID="-100xxxx"

# --- Opsional: URL publik situs (dipakai untuk Open Graph absolut) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
